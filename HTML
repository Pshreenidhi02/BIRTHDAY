<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Birthday Sister! 🎂 Coorg Adventure Awaits 🌲</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@300;400;500;600;700&family=Quicksand:wght@400;600;700&family=Sacramento&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Canvas Confetti Library -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        coorg: {
                            green: '#2d6a4f',
                            lightgreen: '#74c69d',
                            mint: '#d8f3dc',
                            coffee: '#6f4e37',
                            latte: '#ddb892',
                            cream: '#fefae0',
                            peach: '#ffcad4',
                            rose: '#f4acb7',
                        }
                    },
                    fontFamily: {
                        sans: ['Quicksand', 'sans-serif'],
                        heading: ['Fredoka', 'sans-serif'],
                        cursive: ['Sacramento', 'cursive'],
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Quicksand', sans-serif;
            background: linear-gradient(135deg, #fceade 0%, #e8f5e9 50%, #f3e5f5 100%);
            overflow-x: hidden;
            min-height: 100vh;
        }

        .font-heading { font-family: 'Fredoka', sans-serif; }
        .font-cursive { font-family: 'Sacramento', cursive; }

        /* Floating Animations */
        @keyframes floatSlow {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-15px) rotate(3deg); }
        }
        @keyframes floatMedium {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-22px) rotate(-4deg); }
        }
        @keyframes pulseGlow {
            0%, 100% { transform: scale(1); box-shadow: 0 10px 25px -5px rgba(244, 172, 183, 0.4); }
            50% { transform: scale(1.03); box-shadow: 0 20px 35px -5px rgba(244, 172, 183, 0.7); }
        }
        @keyframes shimmer {
            0% { background-position: -200% 0; }
            100% { background-position: 200% 0; }
        }

        .animate-float-slow { animation: floatSlow 6s ease-in-out infinite; }
        .animate-float-medium { animation: floatMedium 4s ease-in-out infinite; }
        .animate-pulse-glow { animation: pulseGlow 3s ease-in-out infinite; }

        /* Card Flip Effect */
        .perspective-1000 { perspective: 1000px; }
        .transform-style-3d { transform-style: preserve-3d; }
        .backface-hidden { backface-visibility: hidden; }
        .rotate-y-180 { transform: rotateY(180deg); }

        /* Glassmorphism */
        .glass-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            border: 2px solid rgba(255, 255, 255, 0.6);
        }
        .glass-card-dark {
            background: rgba(45, 106, 79, 0.9);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #fefae0; }
        ::-webkit-scrollbar-thumb { background: #74c69d; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #2d6a4f; }

        /* Scratch Coupon Overlay Effect */
        .claimed-stamp {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-12deg);
            border: 3px dashed #e63946;
            color: #e63946;
            font-weight: 800;
            padding: 4px 16px;
            border-radius: 8px;
            font-size: 1.25rem;
            pointer-events: none;
            opacity: 0;
            transition: all 0.3s ease;
        }
        .claimed .claimed-stamp {
            opacity: 1;
            transform: translate(-50%, -50%) rotate(-12deg) scale(1.1);
        }
    </style>
</head>
<body class="text-gray-800 relative select-none">

    <!-- Background Floating Decorative Elements -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
        <div class="absolute top-10 left-[8%] text-pink-300 text-3xl animate-float-slow opacity-60">🎈</div>
        <div class="absolute top-24 right-[12%] text-emerald-300 text-4xl animate-float-medium opacity-60">🍃</div>
        <div class="absolute bottom-16 left-[5%] text-amber-600 text-3xl animate-float-slow opacity-50">☕</div>
        <div class="absolute bottom-24 right-[8%] text-rose-300 text-4xl animate-float-medium opacity-60">✨</div>
        <div class="absolute top-[45%] left-[2%] text-emerald-400 text-2xl animate-float-slow opacity-40">🌲</div>
        <div class="absolute top-[60%] right-[3%] text-pink-400 text-3xl animate-float-medium opacity-50">💖</div>
    </div>

    <!-- AUDIO CONTROLS & UTILITY BAR -->
    <div class="fixed top-4 right-4 z-50 flex items-center gap-2">
        <button id="confettiBtn" onclick="triggerConfetti()" class="glass-card hover:bg-white text-pink-600 font-bold p-3 rounded-full shadow-lg transition duration-300 transform hover:scale-110 flex items-center justify-center" title="Blast Confetti! 🎉">
            <i class="fa-solid fa-wand-magic-sparkles text-xl"></i>
        </button>
        <button id="soundToggle" onclick="toggleAudio()" class="glass-card hover:bg-white text-emerald-700 font-bold p-3 rounded-full shadow-lg transition duration-300 transform hover:scale-110 flex items-center justify-center" title="Toggle Sound FX">
            <i id="soundIcon" class="fa-solid fa-volume-xmark text-xl"></i>
        </button>
    </div>

    <!-- ========================================== -->
    <!-- VIEW 1: CUTE BIRTHDAY GREETING CARD SCREEN -->
    <!-- ========================================== -->
    <section id="birthdayCardView" class="min-h-screen flex flex-col items-center justify-center p-4 relative z-10 transition-all duration-700">
        <div class="max-w-md w-full text-center">
            
            <!-- Floating Balloons Header -->
            <div class="flex justify-center gap-4 mb-2 animate-float-slow">
                <span class="text-5xl filter drop-shadow">🎈</span>
                <span class="text-6xl filter drop-shadow animate-bounce">🎁</span>
                <span class="text-5xl filter drop-shadow">🎈</span>
            </div>

            <!-- Greeting Card Wrapper -->
            <div class="glass-card rounded-3xl p-8 shadow-2xl border-4 border-pink-200 relative overflow-hidden transform hover:scale-[1.01] transition-all duration-500">
                
                <!-- Decorative top ribbon -->
                <div class="absolute -top-10 -right-10 w-28 h-28 bg-pink-300 rotate-45 rounded-md opacity-30"></div>
                <div class="absolute -bottom-10 -left-10 w-28 h-28 bg-emerald-300 rotate-45 rounded-md opacity-30"></div>

                <div class="inline-block bg-pink-100 text-pink-600 text-xs font-bold px-4 py-1.5 rounded-full uppercase tracking-widest mb-4 shadow-sm border border-pink-200">
                    ✨ Special Birthday Delivery ✨
                </div>

                <h1 class="font-heading text-4xl sm:text-5xl font-extrabold text-pink-600 mb-2 leading-tight">
                    Happy Birthday <br><span class="font-cursive text-5xl sm:text-6xl text-emerald-700 lowercase">to my amazing</span> Sister! 🎂
                </h1>
                
                <p class="text-gray-600 text-sm sm:text-base mt-3 leading-relaxed">
                    To the world's most wonderful, adventurous, and sweet sister! You deserve a birthday filled with magic, laughter, and unbelievable memories! 💖
                </p>

                <!-- Envelope / Card Graphic -->
                <div class="my-6 py-4 bg-gradient-to-r from-pink-50 via-emerald-50 to-amber-50 rounded-2xl border-2 border-dashed border-pink-300 flex flex-col items-center justify-center relative">
                    <span class="text-6xl my-2 animate-pulse">📜✨</span>
                    <p class="text-xs text-pink-500 font-semibold uppercase tracking-wider">Your secret birthday surprise is ready</p>
                </div>

                <!-- Main CTA Button -->
                <button onclick="openCoorgAdventure()" class="w-full bg-gradient-to-r from-emerald-600 via-teal-500 to-emerald-600 text-white font-heading text-lg font-bold py-4 px-6 rounded-2xl shadow-xl hover:shadow-emerald-300/50 hover:scale-105 active:scale-95 transition-all duration-300 animate-pulse-glow flex items-center justify-center gap-3 group">
                    <span>Unfold Your Coorg Trip! 🌲☕</span>
                    <i class="fa-solid fa-arrow-right group-hover:translate-x-2 transition-transform"></i>
                </button>
            </div>

            <p class="text-xs text-gray-500 mt-4 font-medium">Click the button above to unlock your birthday itinerary 🗺️</p>
        </div>
    </section>

    <!-- ========================================== -->
    <!-- VIEW 2: ADVENTURE HUB (COORG TRIP REVEAL)  -->
    <!-- ========================================== -->
    <section id="adventureHubView" class="hidden min-h-screen pb-20 relative z-10 transition-all duration-700 opacity-0 translate-y-10">
        
        <!-- TOP BANNER HERO HEADER -->
        <header class="relative bg-gradient-to-b from-emerald-800 via-emerald-700 to-coorg-green text-white pt-12 pb-24 px-4 rounded-b-[3rem] shadow-2xl overflow-hidden">
            <!-- Decorative Mist/Cloud Shapes -->
            <div class="absolute inset-0 opacity-15 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]"></div>
            <div class="absolute -bottom-8 left-0 right-0 h-16 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-white/30 to-transparent"></div>

            <div class="max-w-4xl mx-auto text-center relative z-10">
                <div class="inline-flex items-center gap-2 bg-emerald-900/60 backdrop-blur-md px-4 py-1.5 rounded-full border border-emerald-400/30 text-emerald-200 text-xs font-semibold uppercase tracking-wider mb-4">
                    <span>☕ Welcome to Coorg • The Scotland of India 🌲</span>
                </div>
                
                <h1 class="font-heading text-3xl sm:text-5xl md:text-6xl font-bold mb-3 leading-tight drop-shadow-md">
                    Sister's Birthday Getaway! 🏞️✨
                </h1>
                
                <p class="text-emerald-100 text-sm sm:text-lg max-w-2xl mx-auto font-light leading-relaxed">
                    Pack your bags! We're heading to the misty hills, lush coffee plantations, and roaring waterfalls of Coorg. Explore your interactive trip details below!
                </p>

                <!-- Quick Nav Pills -->
                <div class="flex flex-wrap justify-center gap-2 mt-6">
                    <button onclick="scrollToSection('itinerarySection')" class="bg-white/20 hover:bg-white/30 text-white text-xs sm:text-sm px-4 py-2 rounded-full backdrop-blur-sm transition">
                        📍 Itinerary Highlights
                    </button>
                    <button onclick="scrollToSection('voucherSection')" class="bg-pink-500/30 hover:bg-pink-500/50 text-pink-100 text-xs sm:text-sm px-4 py-2 rounded-full backdrop-blur-sm transition">
                        🎁 Birthday Vouchers
                    </button>
                    <button onclick="scrollToSection('packingSection')" class="bg-amber-500/30 hover:bg-amber-500/50 text-amber-100 text-xs sm:text-sm px-4 py-2 rounded-full backdrop-blur-sm transition">
                        🎒 Packing List
                    </button>
                    <button onclick="openSecretLetter()" class="bg-emerald-400 text-emerald-950 font-bold text-xs sm:text-sm px-4 py-2 rounded-full shadow hover:bg-emerald-300 transition">
                        💌 Read Birthday Note
                    </button>
                </div>
            </div>
        </header>

        <!-- MAIN HUB CONTENT CONTAINER -->
        <main class="max-w-5xl mx-auto px-4 -mt-12 relative z-20 space-y-12">

            <!-- 1. TRIP HIGHLIGHT CARDS GRID -->
            <section id="itinerarySection">
                <div class="flex items-center justify-between mb-6 px-2">
                    <div>
                        <h2 class="font-heading text-2xl sm:text-3xl font-bold text-emerald-900">Adventure Itinerary 🧭</h2>
                        <p class="text-gray-600 text-xs sm:text-sm">Click each card to unlock photos, secrets & details!</p>
                    </div>
                    <span class="text-xs bg-emerald-100 text-emerald-800 font-bold px-3 py-1 rounded-full">4 Experience Cards</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    
                    <!-- Card 1: Morning Brew -->
                    <div onclick="openCardModal('brew')" class="glass-card rounded-3xl p-6 shadow-lg border-2 border-amber-200/60 hover:shadow-2xl hover:border-amber-400 transition-all duration-300 cursor-pointer group relative overflow-hidden">
                        <div class="absolute -right-6 -top-6 w-24 h-24 bg-amber-100 rounded-full group-hover:scale-125 transition-transform duration-500 opacity-50"></div>
                        
                        <div class="flex items-start justify-between relative z-10">
                            <div class="w-14 h-14 bg-amber-100 text-amber-800 rounded-2xl flex items-center justify-center text-2xl shadow-inner group-hover:rotate-12 transition-transform">
                                ☕
                            </div>
                            <span class="text-xs font-bold text-amber-800 bg-amber-50 px-3 py-1 rounded-full border border-amber-200">Day 1 • Morning</span>
                        </div>

                        <h3 class="font-heading text-xl font-bold text-amber-950 mt-4 group-hover:text-amber-700 transition">Morning Brew & Misty Hills</h3>
                        <p class="text-gray-600 text-sm mt-2 line-clamp-2">Lush coffee plantation stroll, aromatic freshly brewed bean coffee, and cozy breakfast overlooking estate hills.</p>

                        <div class="mt-4 pt-4 border-t border-amber-100 flex items-center justify-between text-xs font-bold text-amber-700">
                            <span> View Estate Preview & Menu</span>
                            <i class="fa-solid fa-chevron-right group-hover:translate-x-1 transition-transform"></i>
                        </div>
                    </div>

                    <!-- Card 2: Waterfall Chasing -->
                    <div onclick="openCardModal('waterfall')" class="glass-card rounded-3xl p-6 shadow-lg border-2 border-blue-200/60 hover:shadow-2xl hover:border-blue-400 transition-all duration-300 cursor-pointer group relative overflow-hidden">
                        <div class="absolute -right-6 -top-6 w-24 h-24 bg-blue-100 rounded-full group-hover:scale-125 transition-transform duration-500 opacity-50"></div>
                        
                        <div class="flex items-start justify-between relative z-10">
                            <div class="w-14 h-14 bg-blue-100 text-blue-700 rounded-2xl flex items-center justify-center text-2xl shadow-inner group-hover:rotate-12 transition-transform">
                                🏞️
                            </div>
                            <span class="text-xs font-bold text-blue-800 bg-blue-50 px-3 py-1 rounded-full border border-blue-200">Day 1 • Afternoon</span>
                        </div>

                        <h3 class="font-heading text-xl font-bold text-blue-950 mt-4 group-hover:text-blue-700 transition">Waterfall Chasing Expedition</h3>
                        <p class="text-gray-600 text-sm mt-2 line-clamp-2">Roaring Abbey Falls & secluded Chelavara Falls. Includes an interactive waterfall splash checklist!</p>

                        <div class="mt-4 pt-4 border-t border-blue-100 flex items-center justify-between text-xs font-bold text-blue-700">
                            <span> Check Waterfalls & Tips</span>
                            <i class="fa-solid fa-chevron-right group-hover:translate-x-1 transition-transform"></i>
                        </div>
                    </div>

                    <!-- Card 3: Elephant Sanctuary -->
                    <div onclick="openCardModal('elephant')" class="glass-card rounded-3xl p-6 shadow-lg border-2 border-emerald-200/60 hover:shadow-2xl hover:border-emerald-400 transition-all duration-300 cursor-pointer group relative overflow-hidden">
                        <div class="absolute -right-6 -top-6 w-24 h-24 bg-emerald-100 rounded-full group-hover:scale-125 transition-transform duration-500 opacity-50"></div>
                        
                        <div class="flex items-start justify-between relative z-10">
                            <div class="w-14 h-14 bg-emerald-100 text-emerald-800 rounded-2xl flex items-center justify-center text-2xl shadow-inner group-hover:rotate-12 transition-transform">
                                🐘
                            </div>
                            <span class="text-xs font-bold text-emerald-800 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">Day 2 • Morning</span>
                        </div>

                        <h3 class="font-heading text-xl font-bold text-emerald-950 mt-4 group-hover:text-emerald-700 transition">Dubare Elephant Camp & Nature Walk</h3>
                        <p class="text-gray-600 text-sm mt-2 line-clamp-2">River crossing, watching gentle giants bath, feeding session & peaceful forest trails.</p>

                        <div class="mt-4 pt-4 border-t border-emerald-100 flex items-center justify-between text-xs font-bold text-emerald-700">
                            <span> Discover Camp Activities</span>
                            <i class="fa-solid fa-chevron-right group-hover:translate-x-1 transition-transform"></i>
                        </div>
                    </div>

                    <!-- Card 4: Sunset Peak -->
                    <div onclick="openCardModal('sunset')" class="glass-card rounded-3xl p-6 shadow-lg border-2 border-rose-200/60 hover:shadow-2xl hover:border-rose-400 transition-all duration-300 cursor-pointer group relative overflow-hidden">
                        <div class="absolute -right-6 -top-6 w-24 h-24 bg-rose-100 rounded-full group-hover:scale-125 transition-transform duration-500 opacity-50"></div>
                        
                        <div class="flex items-start justify-between relative z-10">
                            <div class="w-14 h-14 bg-rose-100 text-rose-700 rounded-2xl flex items-center justify-center text-2xl shadow-inner group-hover:rotate-12 transition-transform">
                                🌅
                            </div>
                            <span class="text-xs font-bold text-rose-800 bg-rose-50 px-3 py-1 rounded-full border border-rose-200">Day 2 • Sunset & Night</span>
                        </div>

                        <h3 class="font-heading text-xl font-bold text-rose-950 mt-4 group-hover:text-rose-700 transition">Raja's Seat Sunset & Stargazing</h3>
                        <p class="text-gray-600 text-sm mt-2 line-clamp-2">Golden hour panoramic valley views, cozy evening camp vibes, hot cocoa & stargazing session.</p>

                        <div class="mt-4 pt-4 border-t border-rose-100 flex items-center justify-between text-xs font-bold text-rose-700">
                            <span> View Sunset Details</span>
                            <i class="fa-solid fa-chevron-right group-hover:translate-x-1 transition-transform"></i>
                        </div>
                    </div>

                </div>
            </section>

            <!-- 2. BIRTHDAY GIFT VOUCHERS / COUPONS -->
            <section id="voucherSection" class="glass-card rounded-3xl p-6 sm:p-8 shadow-xl border-2 border-pink-200 relative">
                <div class="text-center max-w-xl mx-auto mb-8">
                    <span class="text-xs font-bold text-pink-600 bg-pink-100 px-3 py-1 rounded-full uppercase tracking-wider">Sister Perks 🎫</span>
                    <h2 class="font-heading text-2xl sm:text-3xl font-bold text-pink-700 mt-2">Birthday Gift Vouchers!</h2>
                    <p class="text-gray-600 text-xs sm:text-sm mt-1">Click any coupon to redeem your sister-privileges during the Coorg trip!</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                    
                    <!-- Coupon 1 -->
                    <div id="coupon1" onclick="claimCoupon('coupon1', 'Free Organic Coorg Coffee')" class="bg-gradient-to-br from-amber-50 to-orange-50 border-2 border-dashed border-amber-300 rounded-2xl p-4 relative cursor-pointer hover:scale-105 transition duration-300 shadow-sm flex flex-col justify-between">
                        <div class="claimed-stamp">CLAIMED!</div>
                        <div>
                            <div class="flex justify-between items-center text-amber-800 font-bold text-xs mb-2">
                                <span>COORG SPECIAL</span>
                                <span>☕ #001</span>
                            </div>
                            <h3 class="font-heading text-lg font-bold text-amber-900">1x Free Hot Coffee</h3>
                            <p class="text-xs text-amber-800/80 mt-1">Redeemable at any estate cafe. Pick your favorite roast on me!</p>
                        </div>
                        <button class="mt-4 w-full bg-amber-500 text-white font-bold text-xs py-2 rounded-xl shadow hover:bg-amber-600 transition">
                            Tap to Redeem 🎟️
                        </button>
                    </div>

                    <!-- Coupon 2 -->
                    <div id="coupon2" onclick="claimCoupon('coupon2', 'No Complaints & Luggage Duty')" class="bg-gradient-to-br from-rose-50 to-pink-50 border-2 border-dashed border-rose-300 rounded-2xl p-4 relative cursor-pointer hover:scale-105 transition duration-300 shadow-sm flex flex-col justify-between">
                        <div class="claimed-stamp">CLAIMED!</div>
                        <div>
                            <div class="flex justify-between items-center text-rose-800 font-bold text-xs mb-2">
                                <span>SIBLING VOW</span>
                                <span>👑 #002</span>
                            </div>
                            <h3 class="font-heading text-lg font-bold text-rose-900">No Complaints Pass</h3>
                            <p class="text-xs text-rose-800/80 mt-1">Valid for 1 full day of zero sibling arguing and free bag carrying assistance!</p>
                        </div>
                        <button class="mt-4 w-full bg-rose-500 text-white font-bold text-xs py-2 rounded-xl shadow hover:bg-rose-600 transition">
                            Tap to Redeem 🎟️
                        </button>
                    </div>

                    <!-- Coupon 3 -->
                    <div id="coupon3" onclick="claimCoupon('coupon3', 'Personal Photographer Duty')" class="bg-gradient-to-br from-emerald-50 to-teal-50 border-2 border-dashed border-emerald-300 rounded-2xl p-4 relative cursor-pointer hover:scale-105 transition duration-300 shadow-sm flex flex-col justify-between sm:col-span-2 lg:col-span-1">
                        <div class="claimed-stamp">CLAIMED!</div>
                        <div>
                            <div class="flex justify-between items-center text-emerald-800 font-bold text-xs mb-2">
                                <span>INSTA READY</span>
                                <span>📸 #003</span>
                            </div>
                            <h3 class="font-heading text-lg font-bold text-emerald-900">Personal Photo Director</h3>
                            <p class="text-xs text-emerald-800/80 mt-1">Unlimited photos & aesthetic portrait shots taken until you get your perfect upload!</p>
                        </div>
                        <button class="mt-4 w-full bg-emerald-600 text-white font-bold text-xs py-2 rounded-xl shadow hover:bg-emerald-700 transition">
                            Tap to Redeem 🎟️
                        </button>
                    </div>

                </div>
            </section>

            <!-- 3. PACK YOUR BAGS INTERACTIVE CHECKLIST -->
            <section id="packingSection" class="glass-card rounded-3xl p-6 sm:p-8 shadow-xl border-2 border-emerald-200">
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
                    <div>
                        <span class="text-xs font-bold text-emerald-700 bg-emerald-100 px-3 py-1 rounded-full uppercase tracking-wider">Interactive Prep 🎒</span>
                        <h2 class="font-heading text-2xl sm:text-3xl font-bold text-emerald-900 mt-1">Pack Your Coorg Travel Bag!</h2>
                        <p class="text-gray-600 text-xs sm:text-sm">Check off items as you pack for your trip.</p>
                    </div>
                    <div class="bg-emerald-50 border border-emerald-200 px-4 py-2 rounded-2xl text-right">
                        <span id="packProgressText" class="font-heading font-bold text-emerald-800 text-lg">0 / 6</span>
                        <p class="text-[10px] text-emerald-600 uppercase font-semibold">Items Packed</p>
                    </div>
                </div>

                <!-- Progress bar -->
                <div class="w-full bg-gray-200 rounded-full h-2.5 mb-6 overflow-hidden">
                    <div id="packingProgressBar" class="bg-emerald-500 h-2.5 rounded-full transition-all duration-500" style="width: 0%"></div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3" id="packingListContainer">
                    <!-- Items generated by JS -->
                </div>
            </section>

            <!-- FOOTER WITH SWEET NOTE -->
            <footer class="text-center py-8">
                <div class="inline-block p-4 rounded-3xl glass-card border border-pink-200">
                    <p class="font-cursive text-3xl text-pink-600">Can't wait to make awesome memories with you!</p>
                    <p class="text-xs text-gray-500 font-semibold mt-1">Made with ❤️ for the Best Sister Ever • Happy Birthday!</p>
                </div>
            </footer>

        </main>
    </section>


    <!-- ========================================== -->
    <!-- MODAL 1: TRIP DETAILS EXPANDABLE MODAL     -->
    <!-- ========================================== -->
