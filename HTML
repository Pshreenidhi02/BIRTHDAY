        // Secret Birthday Note Modal
        function openSecretLetter() {
            playCuteSound('pop');
            triggerConfetti();
            const modal = document.getElementById('secretLetterModal');
            modal.classList.remove('opacity-0', 'pointer-events-none');
        }

        function closeSecretLetter() {
            playCuteSound('pop');
            const modal = document.getElementById('secretLetterModal');
            modal.classList.add('opacity-0', 'pointer-events-none');
        }

        // Claim Gift Voucher Logic
        function claimCoupon(id, title) {
            const coupon = document.getElementById(id);
            if (!coupon.classList.contains('claimed')) {
                coupon.classList.add('claimed');
                playCuteSound('chime');
                triggerConfetti();
            }
        }

        // PACKING LIST INTERACTIVE SYSTEM
        const packingItems = [
            { id: 1, name: "Cozy Sweaters & Jackets 🧥", packed: false },
            { id: 2, name: "Comfortable Trekking Shoes 👟", packed: false },
            { id: 3, name: "Camera / Fully Charged Phone 📸", packed: false },
            { id: 4, name: "Sunglasses & Sunscreen 🕶️", packed: false },
            { id: 5, name: "Re-usable Water Bottle 💧", packed: false },
            { id: 6, name: "Cute Travel Outfits 👗", packed: false },
        ];

        function renderPackingList() {
            const container = document.getElementById('packingListContainer');
            container.innerHTML = '';

            let packedCount = 0;

            packingItems.forEach((item, index) => {
                if (item.packed) packedCount++;

                const itemEl = document.createElement('div');
                itemEl.className = `p-3 rounded-2xl border transition-all duration-300 cursor-pointer flex items-center justify-between ${
                    item.packed 
                        ? 'bg-emerald-100/70 border-emerald-300 text-emerald-900 line-through' 
                        : 'bg-white/80 border-gray-200 text-gray-700 hover:border-emerald-300'
                }`;
                itemEl.onclick = () => togglePackItem(index);

                itemEl.innerHTML = `
                    <span class="text-xs font-semibold">${item.name}</span>
                    <div class="w-6 h-6 rounded-lg flex items-center justify-center text-xs ${
                        item.packed ? 'bg-emerald-600 text-white' : 'border border-gray-300'
                    }">
                        ${item.packed ? '✓' : ''}
                    </div>
                `;

                container.appendChild(itemEl);
            });

            // Update Progress Bar & Counter
            const percent = Math.round((packedCount / packingItems.length) * 100);
            document.getElementById('packingProgressBar').style.width = `${percent}%`;
            document.getElementById('packProgressText').innerText = `${packedCount} / ${packingItems.length}`;

            if (packedCount === packingItems.length) {
                triggerConfetti();
            }
        }

        function togglePackItem(index) {
            packingItems[index].packed = !packingItems[index].packed;
            playCuteSound('pop');
            renderPackingList();
        }

        // Initialize on Load
        window.onload = function() {
            renderPackingList();
        }
    </script>
