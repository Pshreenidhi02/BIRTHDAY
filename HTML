            elephant: {
                title: "🐘 Dubare Elephant Camp & Forest Walk",
                badge: "Wildlife & Eco",
                color: "emerald",
                content: `
                    <div class="space-y-4">
                        <div class="bg-emerald-100/60 p-4 rounded-2xl border border-emerald-200 text-emerald-900 text-sm">
